#!/bin/sh
# anr — Anabol read.
# Print one merged segment, or a whole category, by id.
#
#   anr openapi-to-typescript
#   anr security-review
#   anr database-schema-designer --json
#
# Override the structure with ANABOL_STRUCTURE=/path/to/skills.
set -eu

STRUCTURE="${ANABOL_STRUCTURE:-$HOME/.config/opencode/skills}"
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
CLI="${ANABOL_CLI:-$ROOT/src/cli.js}"

if [ $# -eq 0 ]; then
  echo "usage: anr <segment-or-category-id> [--json]" >&2
  exit 1
fi

id=$1
shift
exec node "$CLI" read --structure "$STRUCTURE" --id "$id" "$@"
